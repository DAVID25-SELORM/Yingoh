{
  "name": "nclex-app",
  "version": "1.0.0",
  "description": "NurseFaculty professional NCLEX preparation platform",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:access-promotions": "node --test scripts/access-grants.test.mjs scripts/promotion-pricing.test.mjs scripts/subscription-prices.test.mjs",
    "test:access-concurrency": "node --test scripts/access-grants-concurrency.test.mjs",
    "test:access-ui": "vitest run scripts/access-subscription-ui.test.jsx",
    "check:access-promotions": "deno check --check-js supabase/functions/_shared/promotion-pricing.js supabase/functions/_shared/subscription-prices.js",
    "lint:access-promotions": "deno lint supabase/functions/_shared/promotion-pricing.js supabase/functions/_shared/subscription-prices.js",
    "package:questions": "node scripts/build-question-bank-package.mjs",
    "validate:questions": "node scripts/validate-question-bank.mjs",
    "validate:questions:progress": "node scripts/validate-question-bank.mjs --allow-incomplete",
    "validate:security": "node scripts/validate-security-contracts.mjs",
    "validate:explanations": "node scripts/validate-structured-explanations.mjs",
    "test:lifelong": "node scripts/test-lifelong.mjs && vitest run scripts/lifelong-ui.test.jsx",
    "test:daily-email": "node --test scripts/daily-email.test.mjs scripts/daily-email-diagnostic.test.mjs && vitest run scripts/daily-email-ui.test.jsx",
    "check:daily-email": "deno check --config supabase/functions/daily-question-email/deno.json supabase/functions/daily-question-email/index.ts supabase/functions/daily-email-diagnostic/index.ts scripts/diagnose-daily-email.ts",
    "lint:daily-email": "deno lint --config supabase/functions/daily-question-email/deno.json supabase/functions/daily-question-email scripts/diagnose-daily-email.ts",
    "diagnose:daily-email": "deno run --config supabase/functions/daily-question-email/deno.json --allow-env=SMTP_HOST,SMTP_PORT,SMTP_USER,SMTP_PASS,SMTP_FROM,SMTP_FROM_NAME,SMTP_REPLY_TO,APP_URL --allow-net scripts/diagnose-daily-email.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/react": "^16.3.3",
    "deno": "^2.9.6",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.0"
  }
}
